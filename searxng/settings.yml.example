use_default_settings: true

server:
  secret_key: "CHANGE_ME_TO_A_RANDOM_STRING"
  limiter: false
  image_proxy: false

search:
  safe_search: 0
  formats:
    - html
    - json

engines:
  - name: google
    disabled: false
  - name: bing
    disabled: false
  - name: duckduckgo
    disabled: false
